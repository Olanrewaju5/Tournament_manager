{
  "expo": {
    "name": "TournamentOS",
    "slug": "tournamentos-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "tournamentos",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tournamentos.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.tournamentos.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e04a492f-80b4-4f9e-8847-220083bf2f40"
      }
    }
  }
}
